void logMessage(size_t bufSize, const char *fmt, ...)
{
    char buffer[bufSize];

    va_list args;
    va_start(args, fmt);

    vsnprintf(buffer, bufSize, fmt, args);

    va_end(args);

    // Output to LCD
    lcd_clear();
    lcd_printf("%s", buffer);

    // Output to UART
    uart_sendStr(buffer);
}


