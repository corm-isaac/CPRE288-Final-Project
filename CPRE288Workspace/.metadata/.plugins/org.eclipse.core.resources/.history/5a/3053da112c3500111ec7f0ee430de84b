#include "servo.h"
#include "Timer.h"
#include "math.h"
#include "lcd.h"

#include <stdbool.h>
#include "driverlib/interrupt.h"

volatile uint32_t start_value = 0;  //Period
volatile uint32_t match_value = 0; //low pulse width
volatile uint32_t high_pulse_width = 0;

void servo_init(void){

    SYSCTL_RCGCGPIO_R |= 0x2; //enable port b
    while((SYSCTL_PRGPIO_R & 0x2) == 0) {};

    GPIO_PORTB_AFSEL_R |= 0x20; //et pb5 to alternate function
    GPIO_PORTB_PCTL_R &= ~0x00F00000;  // clear PB5 field
    GPIO_PORTB_PCTL_R |=  0x00700000;  // set PB5 = T1CCP1
    GPIO_PORTB_DIR_R |= 0x20; //sets pb5 as an output
    GPIO_PORTB_DEN_R |= 0x20; //enable digital function on pb5

    SYSCTL_RCGCTIMER_R |= 0x2;  //enable clock for timer 1
    while((SYSCTL_PRTIMER_R & 0x2) == 0) {}   // wait for Timer1 ready

    TIMER1_CTL_R &= ~0x100; //disable timer 1
    TIMER1_CFG_R |= 0x4; //sets the timer to 24 bit mode
    TIMER1_TBMR_R &= ~0x4; //clear bits for pwm mode
    TIMER1_TBMR_R |= 0xA; //set the bits for pwm mode
    //TIMER1_CTL_R &= ~(TIMER_CTL_TBPWML); //disables pwm function
    TIMER1_CTL_R |= TIMER_CTL_TBPWML;
    //?
    //start value
    TIMER1_TBILR_R = (320000 & 0xFFFF); //load lower 16 bits //start value??
    TIMER1_TBPR_R = (320000 >> 16); //load the upper 8 bits

    //set start val
    start_value = (TIMER1_TBPR_R << 16) | TIMER1_TBILR_R; //load prescaler and lower 16 in

    TIMER1_CTL_R |= 0x100; //re-enable clock
}

void servo_move(uint16_t degrees){

    if (degrees > 180) degrees = 180;
    //start value -> GPTMTnILR and GPTMTnPR
    //match value -> GPTMTnMATCHR and GPTMnPMR; width of the low pulse
    //period length - 20ms
    //degrees -> equation/conv rate? -> set match?
    // 1ms -> 0; 1.5ms -> 90; 2ms -> 180
    //linear relationship to obtain time in ms (y = 180x - 180 where x is time in ms and y is degrees; or in other words (y/180) + 1 = x)
    //1ms/ 0 Degrees-> (0.001 / (62.5 x 10^-9)) => 16000; 2 ms / 180 Degrees -> (0.002 / (62.5 x 10^-9)) => 32000

    uint32_t pulseWidth = 16000 + ((degrees * 16000) / 180);

    match_value = 320000 - pulseWidth;

    //set match value
    TIMER1_CTL_R &= ~0x100;     // disable Timer B
    TIMER1_TBMATCHR_R = match_value & 0xFFFF; //lower 16
    TIMER1_TBPMR_R    = match_value >> 16; //upper 8
    TIMER1_CTL_R |= 0x100;      // re-enable Timer B


    //do we need to set the pulse width to low ourselves if the GPTMTAR value is matches the match value?

    //set high pulse width
    high_pulse_width = start_value - match_value; //in clock cycles

    //set duty cycle
    float duty_cycle = (float)pulseWidth / 320000.0f; //high pulse width / 20 ms


}



